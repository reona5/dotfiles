#!/bin/sh
# herdr CLI をリモートの herdr サーバーへ向けて実行するラッパー。
#
# herdr の CLI は Unix ドメインソケット越しにサーバーを操作する。ソケットの位置は
# HERDR_SOCKET_PATH で差し替えられるので、SSH でリモートのソケットを手元へ転送すれば
# 手元の herdr コマンドがそのままリモートのサーバーを操作できる。
#
# Raycast の Herdr 拡張は Herdr Binary(herdrPath) プリファレンスで実行ファイルを
# 指定できるため、そこにこのスクリプトを指すとワークスペースや worktree の管理が
# リモートのサーバーに対して行われる。拡張は 5 秒間隔でポーリングするので、
# 同時に呼ばれてもトンネルを壊し合わないようロックを取る。
#
# ただし worktree の作成・削除はふだん手元の MacBook で行うため、既定はローカル
# 接続とし、リモートを見るのは HERDR_REMOTE_CLI を明示的に有効にしたときだけにする。
# こうしておくと Raycast 側の設定は本スクリプトを指したまま固定でよく、切り替えは
# remote.env の 1 行で済む。
#
# 接続先はこのファイルに書かず、dotfiles 管理外の設定ファイルから読む。
#
#   ~/.config/herdr/remote.env
#     HERDR_REMOTE_HOST=<~/.ssh/config で定義した Host エイリアス>
#     HERDR_REMOTE_CLI=1                         # 任意。CLI/Raycast をリモートへ向ける
#     HERDR_REMOTE_SOCK=/tmp/herdr-remote.sock   # 任意
#
# HERDR_REMOTE_HOST は herdr-remote-attach も参照する。あちらは接続先が必須なので、
# 本スクリプトのローカル/リモート切り替えは HERDR_REMOTE_CLI で独立させている。
#
# リモート側のソケットのパスは $HOME を問い合わせて組み立てるので、ユーザー名が
# 手元と違っていても設定不要。
#
# HERDR_REMOTE_DEBUG=1 を渡すと実行内容を HERDR_REMOTE_LOG(既定 /tmp/herdr-remote.log)
# に記録する。Raycast のように env が細い呼び出し元を調べるとき用。

set -eu

env_file="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/remote.env"

# env_file は既定値の供給源であって、呼び出し側の環境変数より強くない。単純に
# source すると代入が上書きしてしまうので、先に退避して後から書き戻す。これで
# `HERDR_REMOTE_CLI=1 herdr-remote ...` のような一回限りの切り替えができる。
_cli="${HERDR_REMOTE_CLI:-}"
_host="${HERDR_REMOTE_HOST:-}"
[ -f "$env_file" ] && . "$env_file"
[ -n "$_cli" ] && HERDR_REMOTE_CLI="$_cli"
[ -n "$_host" ] && HERDR_REMOTE_HOST="$_host"

herdr_bin="${HERDR_REMOTE_BIN:-/opt/homebrew/bin/herdr}"

# 既定は手元の MacBook。HERDR_SOCKET_PATH を渡さないので通常のローカルソケットを使う。
case "${HERDR_REMOTE_CLI:-0}" in
  1 | true | yes | on) ;;
  *) exec "$herdr_bin" "$@" ;;
esac

if [ -z "${HERDR_REMOTE_HOST:-}" ]; then
  echo "herdr-remote: HERDR_REMOTE_CLI が有効だが HERDR_REMOTE_HOST が未設定です ($env_file に書いてください)" >&2
  exit 1
fi

sock="${HERDR_REMOTE_SOCK:-/tmp/herdr-remote.sock}"
lock="$sock.lock"
log_file="${HERDR_REMOTE_LOG:-/tmp/herdr-remote.log}"

log() {
  [ -n "${HERDR_REMOTE_DEBUG:-}" ] || return 0
  echo "$(date -Iseconds) $*" >>"$log_file"
}

# ソケットの存在だけでは足りない。SSH が sleep や回線切り替えで死ぬとソケットの
# ファイルだけが残り、接続すると ConnectionRefused になる。herdr status server は
# その状態でも exit 0 で not_running を報告するだけなので、終了コードではなく
# JSON の running を見る。
tunnel_alive() {
  [ -S "$sock" ] || return 1
  HERDR_SOCKET_PATH="$sock" "$herdr_bin" status server --json 2>/dev/null |
    grep -q '"running":[[:space:]]*true'
}

release_lock() {
  rmdir "$lock" 2>/dev/null || :
}

ensure_tunnel() {
  if tunnel_alive; then
    return 0
  fi

  # 先に張っている呼び出しがいれば待つ。待っている間に張り終わったらそれを使う。
  waited=0
  while ! mkdir "$lock" 2>/dev/null; do
    if tunnel_alive; then
      log "tunnel established by another invocation"
      return 0
    fi
    waited=$((waited + 1))
    if [ "$waited" -ge 100 ]; then
      # 10 秒解放されないロックは死んだ呼び出しの置き土産とみなして奪う。
      log "stealing stale lock $lock"
      release_lock
      continue
    fi
    sleep 0.1
  done
  trap 'release_lock' EXIT INT TERM

  if ! tunnel_alive; then
    log "re-establishing tunnel to $HERDR_REMOTE_HOST via $sock"
    rm -f "$sock"
    remote_home=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$HERDR_REMOTE_HOST" 'printf %s "$HOME"')
    # ExitOnForwardFailure: forward に失敗した ssh が背景に残って「ソケットが無いのに
    # 成功扱い」になるのを防ぐ。ServerAlive*: 死んだトンネルを ssh 自身に片付けさせる。
    ssh -o BatchMode=yes -o ConnectTimeout=5 -o ExitOnForwardFailure=yes \
      -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
      -fnNT -L "$sock:$remote_home/.config/herdr/herdr.sock" \
      "$HERDR_REMOTE_HOST"

    waited=0
    until tunnel_alive; do
      waited=$((waited + 1))
      if [ "$waited" -ge 50 ]; then
        release_lock
        echo "herdr-remote: $HERDR_REMOTE_HOST へのトンネルを張れませんでした ($sock)" >&2
        exit 1
      fi
      sleep 0.1
    done
    log "tunnel ready"
  fi

  release_lock
  trap - EXIT INT TERM
}

ensure_tunnel
log "run: $*"

if [ -n "${HERDR_REMOTE_DEBUG:-}" ]; then
  set +e
  HERDR_SOCKET_PATH="$sock" "$herdr_bin" "$@"
  rc=$?
  log "exit=$rc"
  exit $rc
fi

HERDR_SOCKET_PATH="$sock" exec "$herdr_bin" "$@"
