#!/bin/sh
# リモートの herdr サーバーへアタッチする専用のターミナルウィンドウを開く。
#
# ふだんのターミナルは起動時に herdr をアタッチするため、そこから `herdr --remote`
# を実行すると herdr のペインの中で herdr を動かすことになる。この入れ子では、
# プレフィックス(ctrl+q)を手前の herdr が先に受け取ってしまい、リモート側の
# ペイン操作ができない。`--remote-keybindings server` はアタッチ側がどちらの設定の
# キーバインドを使うかを選ぶだけなので、この衝突は解消しない。
#
# そこで herdr を起動していないウィンドウを新しく開き、そこで直接リモートへ
# アタッチする。手前に herdr が居ないので、プレフィックスはすべてリモートへ届く。
#
# あわせて、ペイン内の URL を Ctrl+click したときに手元の Chrome で開くための配管も
# 用意する。herdr が open を実行するのはサーバーのある側なので、何もしないとリモートの
# Chrome が立ち上がってしまう。リモートのプラグイン(reona5.open-url-on-client)が
# Unix ソケットへ URL を書き、reverse トンネルを通って手元の herdr-url-listener に
# 届く、という経路を作る。
#
# 接続先は dotfiles 管理外の設定ファイルから読む。
#
#   ~/.config/herdr/remote.env
#     HERDR_REMOTE_HOST=<~/.ssh/config で定義した Host エイリアス>
#     HERDR_URL_SOCK=/tmp/herdr-url-relay.sock   # 任意。変える場合は両側で揃える

set -eu

env_file="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/remote.env"
[ -f "$env_file" ] && . "$env_file"

if [ -z "${HERDR_REMOTE_HOST:-}" ]; then
  echo "herdr-remote-attach: HERDR_REMOTE_HOST が未設定です ($env_file に書いてください)" >&2
  exit 1
fi

bin_dir=$(cd "$(dirname "$0")" && pwd)
sock="${HERDR_URL_SOCK:-/tmp/herdr-url-relay.sock}"

# リスナーとトンネルはアタッチ用ウィンドウより長生きさせたいので、
# このスクリプトの終了に巻き込まれないよう切り離して起動する。
if ! { [ -S "$sock" ] && nc -U "$sock" < /dev/null > /dev/null 2>&1; }; then
  HERDR_URL_SOCK="$sock" nohup "$bin_dir/herdr-url-listener" > /dev/null 2>&1 &
fi

if ! pgrep -f "ssh .*-R $sock:$sock" > /dev/null 2>&1; then
  # リモート側にソケットが残っていると転送だけ黙って無効になるため、
  # 残骸は StreamLocalBindUnlink に消させ、失敗は ExitOnForwardFailure で表に出す。
  ssh -fnNT -o ExitOnForwardFailure=yes -o StreamLocalBindUnlink=yes \
    -R "$sock:$sock" "$HERDR_REMOTE_HOST" ||
    echo "herdr-remote-attach: URL 転送トンネルを張れませんでした（URL はリモート側で開きます）" >&2
fi

# -e はターミナル側の shell 設定(herdr の自動起動)を上書きする。
exec open -na Alacritty --args -e /bin/zsh -lc "herdr --remote '$HERDR_REMOTE_HOST'"
