{
  "defaultProvider": "switchyard",
  "defaultModel": "k3-only",
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "subagents": {
    "defaultModel": "switchyard/weak-only",
    "agentOverrides": {
      "reviewer": {
        "model": "switchyard/strong-only"
      },
      "oracle": {
        "model": "switchyard/k3-only"
      }
    }
  },
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@gotgenes/pi-permission-system",
    "npm:@narumitw/pi-btw",
    {
      "source": "git:github.com/himorishige/pi-coding-agent-extensions",
      "extensions": [
        "./extensions/focus-ui.ts",
        "./extensions/plan-mode/index.ts"
      ]
    },
    "npm:pi-web-access",
    "npm:pi-lens",
    "git:github.com/ahm3tj4f/pi-undo",
    "git:github.com/sting8k/pi-vcc",
    "npm:pi-codex-image-gen",
    "git:github.com/earendil-works/pi-transcribe"
  ],
  "lastChangelogVersion": "0.84.2",
  "theme": "dark",
  "tuiMode": "fullscreen",
  "defaultThinkingLevel": "medium"
}