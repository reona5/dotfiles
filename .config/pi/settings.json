{
  "defaultProvider": "switchyard",
  "defaultModel": "auto",
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "subagents": {
    "defaultModel": "switchyard/weak-only",
    "agentOverrides": {
      "reviewer": {
        "model": "switchyard/strong-only"
      },
      "oracle": {
        "model": "switchyard/k3-only"
      }
    }
  },
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@gotgenes/pi-permission-system",
    "npm:@narumitw/pi-btw",
    "git:github.com/himorishige/pi-coding-agent-extensions",
    "npm:pi-web-access",
    "npm:pi-lens",
    "git:github.com/ahm3tj4f/pi-undo"
  ],
  "lastChangelogVersion": "0.84.2",
  "theme": "dark",
  "tuiMode": "fullscreen",
  "defaultThinkingLevel": "medium"
}