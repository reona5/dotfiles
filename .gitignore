### all ignore ###
/*
/.**

### not ignore ###
!/.bin/
!/.bin/**
!/.bin.local
!/.bin.local/**
!/.bundle/
!/.bundle/config
!/.config/
/.config/*
!/.config/alacritty/
/.config/alacritty/*
!/.config/alacritty/alacritty.toml
!/.config/alacritty/catppuccin-mocha.toml
!/.config/claude/
!/.config/claude/hooks/
/.config/claude/hooks/*
!/.config/claude/hooks/*.sh
# hooks/ は ~/.claude の実体（歴史的な名前）。配下は履歴・セッション・キャッシュ等の
# ランタイムデータなので既定で全無視し、設定ファイルだけを個別に拾う。
!/.config/claude/hooks/settings.json
!/.config/claude/hooks/statusline.py
# 自作 skill の実体は /skills/ に置き、ここには symlink だけを置く。
!/.config/claude/hooks/skills/
!/.config/claude/hooks/skills/**
# gh 由来の skill は mise.toml の bootstrap で `gh skill install` する（実体は持たない）。
/.config/claude/hooks/skills/gh-stack/
!/.config/codex/
!/.config/codex/**
!/.config/gh/
!/.config/gh/state.yml
!/.config/gh/config.yml
!/.config/git/
!/.config/git/**
!/.config/herdr/
/.config/herdr/*
!/.config/herdr/config.toml
!/.config/herdr/plugins/
/.config/herdr/plugins/*
!/.config/herdr/plugins/claude-on-worktree/
!/.config/herdr/plugins/claude-on-worktree/**
!/.config/iterm2/
!/.config/iterm2/AppSupport
!/.config/lazygit
!/.config/lazygit/config.yml
!/.config/mise/
!/.config/mise/config.toml
!/.config/neofetch
!/.config/neofetch/**
!/.config/nvim/
!/.config/nvim/**
!/.config/pnpm/
!/.config/pnpm/5/
!/.config/pnpm/5/package.json
!/.config/sheldon/
!/.config/sheldon/**
!/.config/zeno/
!/.config/zeno/**
!/.config/zsh/
!/.config/zsh/**
!/.ctags.d/
!/.ctags.d/config.ctags
!/.fzf.zsh
!/.github/
!/.github/**
!/.gitignore
!/.npmrc
!/.tmux.conf
!/.textlintrc.json
!/.tmux/
!/.tmux/plugins/
!/.tmux/plugins/**
!/.tmux/log/
!/.vimrc
!/.vim/
!/.vim/**
!/.xvimrc
!/.zshrc
!/.zshrc.lazy
!/.zshenv

# 自作 agent skill の source of truth（gh skill publish が探索するレイアウト）
!/skills/
!/skills/**

!/AGENTS.md
!/changelog.config.js
!/LICENSE
!/mise.toml
!/README.md
