### all ignore ###
/*
/.**

### not ignore ###
!/.bin/
!/.bin/**
!/.bin.local
!/.bin.local/**
!/.bundle/
!/.bundle/config
!/.config/
/.config/*
!/.config/alacritty/
/.config/alacritty/*
!/.config/alacritty/alacritty.toml
!/.config/alacritty/catppuccin-mocha.toml
# ~/.claude は実ディレクトリのままにし（Claude Code がランタイムデータを書き込む）、
# 管理対象だけを ~/.claude/<name> -> ここ、の個別 symlink で張る（mise.toml の [dotfiles]）。
# 既定で全無視し、追跡するものだけを個別に拾う。
!/.config/claude/
/.config/claude/*
!/.config/claude/settings.json
!/.config/claude/statusline.py
# hooks/ は ~/.claude/hooks の実体。hook スクリプトだけを置く。
!/.config/claude/hooks/
/.config/claude/hooks/*
!/.config/claude/hooks/*.sh
# 自作 skill の実体は /skills/ に置き、ここには symlink だけを置く。
!/.config/claude/skills/
!/.config/claude/skills/**
# gog skills は openclaw/gogcli から取得した実体を ~/.agents/skills に置き、
# ここへは symlink を張るだけ（絶対パスなのでコミットしない）。
/.config/claude/skills/gog
/.config/claude/skills/gog-*
# gh 由来の skill は mise.toml の bootstrap で `gh skill install` する（実体は持たない）。
/.config/claude/skills/gh-stack/
!/.config/codex/
!/.config/codex/**
!/.config/gh/
!/.config/gh/state.yml
!/.config/gh/config.yml
!/.config/git/
!/.config/git/**
!/.config/herdr/
/.config/herdr/*
!/.config/herdr/config.toml
!/.config/herdr/plugins/
/.config/herdr/plugins/*
!/.config/herdr/plugins/claude-on-worktree/
!/.config/herdr/plugins/claude-on-worktree/**
!/.config/herdr/plugins/open-url-on-client/
!/.config/herdr/plugins/open-url-on-client/**
!/.config/iterm2/
!/.config/iterm2/AppSupport
!/.config/lazygit
!/.config/lazygit/config.yml
!/.config/mise/
!/.config/mise/config.toml
!/.config/neofetch
!/.config/neofetch/**
!/.config/nvim/
!/.config/nvim/**
# pi の設定は ~/.pi/agent/<name> への個別 symlink で張る（mise.toml の [dotfiles]）。
# ~/.pi/agent/ には auth.json（provider の資格情報）と models-store.json も同居する
# ため、既定で全無視し追跡するものだけを拾う。
!/.config/pi/
/.config/pi/*
!/.config/pi/keybindings.json
!/.config/pi/models.json
!/.config/pi/permission-system.json
!/.config/pi/settings.json
!/.config/pi/turn-recap.json
!/.config/pnpm/
!/.config/pnpm/5/
!/.config/pnpm/5/package.json
!/.config/sheldon/
!/.config/sheldon/**
!/.config/zeno/
!/.config/zeno/**
!/.config/zsh/
!/.config/zsh/**
!/.ctags.d/
!/.ctags.d/config.ctags
!/.fzf.zsh
!/.github/
!/.github/**
!/.gitignore
!/.npmrc
!/.tmux.conf
!/.textlintrc.json
!/.tmux/
!/.tmux/plugins/
!/.tmux/plugins/**
!/.tmux/log/
!/.vimrc
!/.vim/
!/.vim/**
!/.xvimrc
!/.zshrc
!/.zshrc.lazy
!/.zshenv

# 自作 agent skill の source of truth（gh skill publish が探索するレイアウト）
!/skills/
!/skills/**

!/AGENTS.md
!/changelog.config.js
!/LICENSE
!/mise.toml
!/README.md
